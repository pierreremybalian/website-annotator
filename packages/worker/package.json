    "test": "vitest run"
  },
  "dependencies": {
    "@annotate/shared": "workspace:*",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.10",
    "@cloudflare/workers-types": "^5.20261029.1",
    "typescript": "^7.0.2",
    "vitest": "~4.1.12",
    "wrangler": "^4.155.0"
  }
}
